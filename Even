import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int odd = 0;
        int even = 0;

        for (int i = 0; i < n; i++) {
            long value = sc.nextLong();

            if (value % 2 == 0) {
                even++;
            } else {
                odd++;
            }
        }

        System.out.println(odd + " " + even);

        sc.close();
    }
}

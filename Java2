import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        long sum = 0;

        for (long i = 1; i * i <= n; i++) {
            if (n % i == 0) {
                if (i != n) {
                    sum += i;
                }

                long other = n / i;
                if (other != i && other != n) {
                    sum += other;
                }
            }
        }

        System.out.println(sum);
        sc.close();
    }
}
